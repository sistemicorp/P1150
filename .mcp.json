{
  "mcpServers": {
    "p1150": {
      "type": "stdio",
      "command": "${CLAUDE_PROJECT_DIR:-.}/.venv/Scripts/python.exe",
      "args": ["-m", "p1150_mcp"],
      "env": {
        "PYTHONPATH": "${CLAUDE_PROJECT_DIR:-.}",
        "P1150_SN": "${P1150_SN:-}",
        "P1150_BATTERY_MAH": "${P1150_BATTERY_MAH:-}",
        "P1150_RUNS_DIR": "${P1150_RUNS_DIR:-}",
        "P1150_MAX_CAPTURE_S": "${P1150_MAX_CAPTURE_S:-900}"
      }
    }
  }
}